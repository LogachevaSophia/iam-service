# Скопируйте в .env и подставьте значения (в CI — GitHub Secrets → inject в deploy)

POSTGRES_PASSWORD=iam
JWT_SECRET=replace-with-long-random-string

# Clinrec (Swagger: /swagger/index.html). Свой контейнер в Docker-сети: http://clinrec:8000
CLINREC_BASE_URL=http://51.250.100.64:8081
CLINREC_API_TOKEN=

# Первый старт: применить миграции Prisma (в docker-compose по умолчанию true)
RUN_MIGRATIONS=true

# URL API для браузера (docker build web). За gateway: /api
# Публичный стенд: https://your-domain.example/api
VITE_API_BASE_URL=/api

# Порт gateway на хосте (docker-compose)
# GATEWAY_PORT=8080

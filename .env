# Server
PORT=50051
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/iam"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=300

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_ACCESS_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800

# BCrypt
BCRYPT_SALT_ROUNDS=10

# Monitoring
MONITORING_ENABLED=true
METRICS_PORT=9090

# Cache
CACHE_ENABLED=true
USER_PERMISSIONS_TTL=300
RESOURCE_INFO_TTL=60

# Audit
AUDIT_ENABLED=true
SLOW_QUERY_THRESHOLD_MS=100

# Logging
LOG_LEVEL=info

# Clinrec Backend (REST proxy forwards /api/* → this URL, except IAM routes)
CLINREC_BASE_URL=http://51.250.100.64:8000
# CLINREC_API_TOKEN=
# REST proxy HTTP port (default 3000). Run: npm run rest-proxy
# REST_PROXY_PORT=3000
{
  "name": "iam-service",
  "version": "1.0.0",
  "description": "IAM Service for Clinical Guidelines System",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && npm run proto:generate",
    "proto:generate": "grpc_tools_node_protoc --js_out=import_style=commonjs,binary:./src/generated --grpc_out=./src/generated --plugin=protoc-gen-grpc=./node_modules/.bin/grpc_tools_node_protoc_plugin --ts_out=./src/generated --proto_path=./src/proto ./src/proto/iam.proto",
    "start:grpc": "node dist/server.js",
    "start:rest": "node rest-proxy.js",
    "start:dev": "concurrently \"npm run dev:grpc\" \"npm run start:rest\"",
    "dev:grpc": "ts-node-dev --respawn --transpile-only src/server.ts",
    "start": "concurrently \"npm run start:grpc\" \"npm run start:rest\"",
    "dev": "concurrently \"npm run dev:grpc\" \"npm run start:rest\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "studio": "prisma studio",
    "seed": "ts-node prisma/seed.ts",
    "rest-proxy": "node rest-proxy.js"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.7.15",
    "@prisma/client": "^5.22.0",
    "axios": "^1.15.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "cron": "^2.4.4",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-http-proxy": "^2.1.2",
    "ioredis": "^5.10.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.3",
    "prom-client": "^14.2.0",
    "uuid": "^9.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.37",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.1",
    "grpc_tools_node_protoc_ts": "^5.3.3",
    "grpc-tools": "^1.13.1",
    "jest": "^29.7.0",
    "prettier": "^3.8.1",
    "prisma": "^5.22.0",
    "ts-jest": "^29.4.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "directories": {
    "test": "tests"
  },
  "author": "",
  "license": "ISC"
}